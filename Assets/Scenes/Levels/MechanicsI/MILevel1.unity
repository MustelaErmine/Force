    - target: {fileID: 5026353347205881321, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: m_IsActive
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5191040942082592007, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E!\r\n       
        \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C\r\n       
        \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C. \u041D\u0430\u0436\u043C\u0438\u0442\u0435\r\n       
        \u043D\u0430 \u041C\u0430\u0442\u0438\u043B\u044C\u0434\u0443 \u0441 \u043E\u0431\u0432\u043E\u0434\u043A\u043E\u0439,\r\n       
        \u0430 \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435\r\n       
        \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435\r\n       
        \u0432 \u043B\u044E\u0431\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430,\r\n       
        \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C\r\n       
        \u043A \u043D\u0435\u0439 \u0441\u0438\u043B\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 5430925754643494671, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E!
        \u0421\u043F\u0430\u0441\u0438\u0431\u043E, \u0447\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
        \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
        \u043D\u0430 \u041C\u0430\u0442\u0438\u043B\u044C\u0434\u0443 \u0441 \u043E\u0431\u0432\u043E\u0434\u043A\u043E\u0439,
        \u0430 \u0437\u0430\u0442\u0435\u043C \u043D\u0430\u0436\u043C\u0438\u0442\u0435
        \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435
        \u0432 \u043B\u044E\u0431\u043E\u0439 \u0447\u0430\u0441\u0442\u0438 \u044D\u043A\u0440\u0430\u043D\u0430,
        \u0447\u0442\u043E\u0431\u044B \u043F\u0440\u0438\u043C\u0435\u043D\u0438\u0442\u044C
        \u043A \u043D\u0435\u0439 \u0441\u0438\u043B\u0443."
      objectReference: {fileID: 0}
    - target: {fileID: 7279395361252729250, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: m_DrawMode
      value: 0
      objectReference: {fileID: 0}
