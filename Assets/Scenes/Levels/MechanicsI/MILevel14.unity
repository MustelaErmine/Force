      objectReference: {fileID: 0}
    - target: {fileID: 5191040942082592007, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430\r\n       
        \u044D\u0442\u0438 \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u0433\u0438\u0440\u0438\r\n       
        \u0438 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435\r\n       
        \u0442\u0440\u0430\u0441\u0441\u0435\u0440\u044B! \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E,\r\n       
        \u0447\u0442\u043E \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\r\n       
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u041C\u0430\u0442\u0438\u043B\u044C\u0434\u0443,\r\n       
        \u043D\u043E \u0438 \u0432\u0441\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B\r\n       
        \u0441 \u043E\u0431\u0432\u043E\u0434\u043A\u043E\u0439."
      objectReference: {fileID: 0}
    - target: {fileID: 5430925754643494671, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430
        \u044D\u0442\u0438 \u0447\u0443\u0434\u0435\u0441\u043D\u044B\u0435 \u0433\u0438\u0440\u0438
        \u0438 \u043D\u0435 \u043C\u0435\u043D\u0435\u0435 \u043F\u0440\u0435\u043A\u0440\u0430\u0441\u043D\u044B\u0435
        \u0442\u0440\u0430\u0441\u0441\u0435\u0440\u044B! \u041D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E,
        \u0447\u0442\u043E \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u044C
        \u043D\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u041C\u0430\u0442\u0438\u043B\u044C\u0434\u0443,
        \u043D\u043E \u0438 \u0432\u0441\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B
        \u0441 \u043E\u0431\u0432\u043E\u0434\u043A\u043E\u0439."
      objectReference: {fileID: 0}
