      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 5191040942082592007, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u044D\u0442\u043E\u0433\u043E\r\n       
        \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u044B \u0438\u043C\u0435\u0435\u0442\u0435\r\n       
        \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C\r\n       
        \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u044B\r\n       
        \u0444\u0438\u0437\u0438\u043A\u0438. \u0421\u0435\u0439\u0447\u0430\u0441\r\n       
        \u0432\u044B \u0432, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B,\r\n       
        \u0431\u0435\u0437\u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.\r\n       
        \u041D\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435\r\n       
        \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
    - target: {fileID: 5191040942082592007, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: localedString
      value: 
      objectReference: {fileID: 11400000, guid: 4683fa109ed5ba3449abd37fbedbb7d1, type: 2}
    - target: {fileID: 5430925754643494671, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041D\u0430\u0447\u0438\u043D\u0430\u044F \u0441 \u044D\u0442\u043E\u0433\u043E
        \u0443\u0440\u043E\u0432\u043D\u044F \u0432\u044B \u0438\u043C\u0435\u0435\u0442\u0435
        \u0432\u043E\u0445\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C \u0432\u043A\u043B\u044E\u0447\u0430\u0442\u044C
        \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0430\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u044B
        \u0444\u0438\u0437\u0438\u043A\u0438. \u0421\u0435\u0439\u0447\u0430\u0441
        \u0432\u044B \u0432, \u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C \u0431\u044B,
        \u0431\u0435\u0437\u0432\u044B\u0445\u043E\u0434\u043D\u043E\u0439 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438.
        \u041D\u043E \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
        \u0432\u043A\u043B\u044E\u0447\u0438\u0442\u044C \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u044E!"
      objectReference: {fileID: 0}
