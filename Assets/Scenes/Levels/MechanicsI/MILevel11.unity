    - target: {fileID: 5191040942082592007, guid: 4ddc6d21ac1c3d2498659a57254fa93b, type: 3}
      propertyPath: text
      value: "\u041E\u0433\u043E! \u041F\u043E\u0445\u043E\u0436\u0435, \u0432\u044B\r\n       
        \u0433\u043E\u0442\u043E\u0432\u044B \u043F\u0440\u043E\u0442\u0435\u0441\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C\r\n       
        \u043C\u043E\u0438 \u0441\u0432\u0435\u0440\u0445-\u043F\u0440\u0443\u0436\u0438\u043D\u044B!\r\n       
        \u041E\u043D\u0438 \u043C\u043E\u0433\u0443\u0442 \u043F\u043E\u043A\u0430\u0437\u0430\u0442\u044C\u0441\u044F\r\n       
        \u0441\u043B\u0430\u0431\u044B\u043C\u0438, \u043D\u043E \u043F\u043E\u043C\u043D\u0438\u0442\u0435\r\n       
        \u043E \u0441\u0432\u043E\u0438\u0445 \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044F\u0445."
