  m_text: "\u041F\u0440\u0438\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044E! \u0421\u043F\u0430\u0441\u0438\u0431\u043E,
    \u0447\u0442\u043E \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u043B\u0438\u0441\u044C
    \u043D\u0430\u043C \u043F\u043E\u043C\u043E\u0447\u044C. \u041D\u0430\u0436\u043C\u0438\u0442\u0435
