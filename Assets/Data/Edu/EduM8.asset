  m_Script: {fileID: 11500000, guid: 92deb02f64e30a8448dd083e1ed8f0eb, type: 3}
  m_Name: EduM8
  m_EditorClassIdentifier: 
  strings:
  - locale: 0
    value: "\u041E! \u0420\u0430\u0434, \u0447\u0442\u043E \u0432\u044B \u0434\u043E\r\n       
      \u0441\u044E\u0434\u0430 \u0434\u043E\u0431\u0440\u0430\u043B\u0438\u0441\u044C.\r\n       
      \u0422\u0435\u043F\u0435\u0440\u044C \u0432\u044B \u043C\u043E\u0436\u0435\u0442\u0435\r\n       
      \u0443\u043F\u0440\u0430\u0432\u043B\u044F\u0442\u044C \u0437\u0430\u043A\u043E\u043D\u043E\u043C\r\n       
      \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0438\u043C\u043F\u0443\u043B\u044C\u0441\u0430.\r\n       
      \u0415\u0441\u043B\u0438 \u043E\u043D \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D,\r\n       
      \u043D\u0438\u0447\u0442\u043E \u043F\u0440\u043E\u0441\u0442\u043E \u043D\u0435\r\n       
      \u0431\u0443\u0434\u0435\u0442 \u0434\u0432\u0438\u0433\u0430\u0442\u044C\u0441\u044F.\r\n       
      \u0410 \u0442\u043E\u0447\u043D\u0435\u0435, \u0443\u0441\u043A\u043E\u0440\u044F\u0442\u044C\u0441\u044F.\r\n       
      \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0441\u0430\u043C\u0438!"
  - locale: 1
    value: Oh! Glad you made it this far. Now you can control the law of conservation
      of momentum. If it's off, nothing will just move. Or rather, accelerate. Try
      it yourself!
